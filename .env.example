# ───────────── Site ─────────────
APP_URL=http://localhost:3000            # production: https://yourdomain.com (no trailing slash)
NEXT_PUBLIC_PRICE_LABEL=                 # optional, e.g. $19 — Whop checkout always shows the real price
NEXT_PUBLIC_SUPPORT_EMAIL=               # optional mailto fallback shown in support + footer

# ───────────── Whop (payment processing only) ─────────────
# Sandbox: create everything on sandbox.whop.com, set WHOP_SANDBOX=true. Production: remove it / set false.
# Sandbox IDs do NOT transfer — recreate product + plan on whop.com for production.
WHOP_SANDBOX=true
WHOP_API_KEY=                            # server-only company API key
WHOP_ACCOUNT_ID=                         # biz_...
WHOP_PRODUCT_ID=                         # prod_...   (webhook ignores payments for other products)
WHOP_PLAN_ID=                            # plan_...   one-time plan for the Playbook
WHOP_WEBHOOK_SECRET=                     # from the webhook you register for payment.succeeded -> {APP_URL}/api/webhooks/whop
WHOP_APP_ID=                             # app_...    Whop app used ONLY for Support Chat OAuth (redirect: {APP_URL}/api/whop/oauth/callback)

# ───────────── Delivery ─────────────
DOWNLOAD_TOKEN_SECRET=                   # 32+ random chars:  openssl rand -base64 32
RESEND_API_KEY=                          # without it the link is only logged to the server console (dev)
EMAIL_FROM="Snack Swap <hello@yourdomain.com>"   # must be a verified Resend domain

# ───────────── Private PDF storage (pick one) ─────────────
# A) S3 / Cloudflare R2 (recommended for production)
S3_BUCKET=
S3_KEY=Snack_Swap_Playbook.pdf
S3_REGION=auto
S3_ENDPOINT=                             # R2: https://<accountid>.r2.cloudflarestorage.com  (leave empty for AWS S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# B) Local dev only: put the PDF at ./private/Snack_Swap_Playbook.pdf (or set PRIVATE_PDF_PATH)
# PRIVATE_PDF_PATH=

# ───────────── Orders / idempotency store ─────────────
# Required on Vercel (serverless instances don't share memory). Upstash Redis or Vercel KV (REST):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: link buyers to the product's Files app on Whop (their purchase unlocks it)
WHOP_ACCESS_URL=
